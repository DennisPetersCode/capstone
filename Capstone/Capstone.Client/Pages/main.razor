@page "/agri"
@rendermode InteractiveAuto
<head>
    <link rel="stylesheet" href="../../Styles/main.css"
</head>
<PageTitle>Counter</PageTitle>

<div class="main">
    <div class="top">
        @if(fields.Length > 0){
            <div class="fields-container">
                <table>
                    @for(int j = 0; j < HighestPrimeFactor(fields.Length); j++)
                    {
                        <tr class=field-row>
                        @for (int i = 0; i < HighestPrimeFactor(fields.Length); i++)
                            {
                                try
                                {
                                    <td class="field-cell">@fields[i + j].FieldName</td>
                                }
                                catch
                                {
                                    break;
                                }
                            }
                        </tr>
                    }
                </table>
            </div>
        }
        else
        {
            <h1>Loading...</h1>
        }
        <div class="metrics">
            <iframe></iframe>
        </div>
    </div>
    <span></span>
    <div class="db-link-container">
        <table onscroll="">
            <tr></tr>
        </table>
    </div>
</div>

@code {
    Field[] fields;
    PlantData[] plantdata;
    protected override async Task OnInitializedAsync()
    {

    }

    private class Field
    {
        private int fieldId, cropIdd, weeklyWater, hoursOfSunlight;
        private string fieldName;

        public FieldName{ get; set; }

        public Field[] PopFields()
        {
            throw NotImplementedException
        }
    }

    private class PlantData
    {
        private int plantId;
        private string plantName;
    }

    public int HighestPrimeFactor(int num)
    {
        int prime = 0;
        for(int i = 0; i < num/2; i++)
        {
            if (i * i < num)
            {
                prime = i;
            }
            else
            {
                break;
            }
        }
        if (prime ^ 2 < num)
        {
            return prime + 1
        }
        else
        {
            return prime;
        
        }
    }
}
